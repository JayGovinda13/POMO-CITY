# ── Supabase ──────────────────────────────────────────────────────────────
# Sem estas variáveis o jogo usa o modo local (arquivos em .data/).
# Painel do Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: SOMENTE no servidor. Nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Jogo ──────────────────────────────────────────────────────────────────
# Duração do foco em segundos (padrão 1500 = 25 min). Use 10 para testar em dev.
FOCUS_SECONDS=1500
# Tolerância (s) para recarregar a página sem que conte como "fechou o jogo" (padrão 120).
LEAVE_GRACE_SECONDS=120

# ── Google AdSense (opcional) ─────────────────────────────────────────────
# ID de editor (ca-pub-...) e IDs dos blocos de anúncio criados no painel do AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TITLE=
NEXT_PUBLIC_ADSENSE_SLOT_NEWSPAPER=

# ── Doações (opcional) ────────────────────────────────────────────────────
# Pix: use uma CHAVE ALEATÓRIA (não exponha CPF/telefone/e-mail). Nome e cidade como no banco.
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_PIX_NAME=
NEXT_PUBLIC_PIX_CITY=
# Cartão/internacional: link público de doação (Stripe Payment Link, Ko-fi, Apoia.se...).
NEXT_PUBLIC_DONATE_URL=
